{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*github.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.github/scripts/public_text.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
